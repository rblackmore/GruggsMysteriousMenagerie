<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
  <Script file="GMM_CompanionTemplates.lua" />
  <!-- Companion Model Element Template -->
  <PlayerModel
    name="GMM_CompanionModelTemplate" mixin="GMM_CompanionModelMixin" virtual="true"
    enableMouse="true">
    <Size x="100" y="132" />
    <Layers>
      <Layer level="BACKGROUND">
        <Texture parentKey="Background" setAllPoints="true">
          <Color r="0.025" g="0.025" b="0.025" />
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <Texture parentKey="Border" atlas="transmog-itemCard-default" useAtlasSize="true">
          <Anchors>
            <Anchor point="CENTER" />
          </Anchors>
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <Texture parentKey="SelectedBorder" atlas="transmog-itemCard-transmogrified-pending"
          hidden="true"
          useAtlasSize="true">
          <Anchors>
            <Anchor point="CENTER" />
          </Anchors>
        </Texture>
        <Texture parentKey="FavoriteIcon" atlas="transmog-icon-favorite" hidden="true"
          useAtlasSize="true">
          <Anchors>
            <Anchor point="TOPRIGHT" x="-4" y="-4" />
          </Anchors>
        </Texture>
      </Layer>
      <Layer level="HIGHLIGHT">
        <Texture parentKey="BorderHighlight" atlas="transmog-itemCard-hover"
          alphaMode="ADD" useAtlasSize="true" hidden="true">
          <Anchors>
            <Anchor point="CENTER" />
          </Anchors>
        </Texture>
      </Layer>
    </Layers>
    <Scripts>
      <OnEnter method="OnEnter" />
      <OnLeave method="OnLeave" />
      <OnMouseUp method="OnMouseUp" />
      <OnMouseDown method="OnMouseDown" />
      <!-- <OnLoad method="OnLoad" />
      <OnModelLoaded method="OnModelLoaded" />
      <OnMouseDown method="OnMouseDown" />
      <OnMouseUp method="OnMouseUp" />
      <OnEnter method="OnEnter" />
      <OnLeave method="OnLeave" />
      <OnShow method="OnShow" />
      <OnHide method="OnHide" />
      <OnEvent method="OnEvent" /> -->
    </Scripts>
  </PlayerModel>
</Ui>