{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "deploy",
      "type": "shell",
      "command": "./build.ps1 && ./install.ps1",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "publish",
      "type": "shell",
      "command": "./build.ps1 && ./publish.ps1",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "close": false
      }
    },
    {
      "label": "build",
      "type": "shell",
      "command": "./build.ps1",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "install-retail",
      "type": "shell",
      "command": "./install.ps1 retail",
      "group": {
        "kind": "none",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "close": false
      }
    },
    {
      "label": "install-forever",
      "type": "shell",
      "command": "./install.ps1 forever",
      "group": {
        "kind": "none",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "rm -R build; rm -R publish",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "close": false
      }
    }
  ]
}